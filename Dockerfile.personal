# syntax=docker/dockerfile:1
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PERSONAL_DATA_DIR=/data PORT=8000
WORKDIR /app
COPY requirements-personal.txt ./
RUN --mount=type=secret,id=build_ca \
    if [ -f /run/secrets/build_ca ]; then \
      PIP_CERT=/run/secrets/build_ca pip install --no-cache-dir -r requirements-personal.txt; \
    else \
      pip install --no-cache-dir -r requirements-personal.txt; \
    fi
COPY personal ./personal
RUN mkdir -p /data && chmod 700 /data
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8000')+'/healthz',timeout=4)"
CMD ["bash", "personal/serve.sh"]
