# Copiar a .env para desarrollo. En Netlify, configurar como variables secretas.
# Nunca usar prefijo VITE_ para contraseñas, tokens o conexiones.
NODE_ENV=development
APP_URL=http://localhost:5173
PORT=3001

# DATABASE_URL: conexión PostgreSQL con pool, SSL y connection_limit=2.
# DIRECT_URL: conexión directa con SSL para migraciones Prisma.
DATABASE_URL=
DIRECT_URL=

# Generar SESSION_SECRET con: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Bootstrap de un solo uso: se ignora si ya existe un administrador.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
WORKSPACE_NAME=Mi espacio

# Meta: asignar valores reales únicamente en la configuración privada.
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=

# El modo seguro es el predeterminado; no contacta a Meta al enviar.
DRY_RUN=true
MESSAGES_PER_MINUTE=3
MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=60
RETRY_MAX_SECONDS=3600
QUEUE_BATCH_SIZE=10
QUEUE_BUDGET_MS=20000
CLAIM_LEASE_SECONDS=120
MAX_MESSAGE_AGE_HOURS=24
CSV_MAX_BYTES=2097152
CSV_MAX_ROWS=10000
DEFAULT_PHONE_COUNTRY=MX
LOG_LEVEL=info
